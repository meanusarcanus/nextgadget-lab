# Meta / Instagram Graph API Configuration
# Required for live Instagram automated posting via Meta API
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here
INSTAGRAM_ACCESS_TOKEN=your_long_lived_meta_access_token_here

# Affiliate Program Config
AMAZON_AFFILIATE_TAG=techspecdiges-20

# Link-in-Bio Base URL (Where your dynamic bio hub is deployed)
BIO_HUB_BASE_URL=https://nextgadgetlab.github.io/bio

# LLM API Config (Optional - built-in technical copy engine used if left blank)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Webhook Notifications (Optional - for manual staging/approval without Meta Facebook setup)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Image CDN / Upload Storage (Optional - imgbb API key for public URL image hosting needed by Meta Graph API)
IMGBB_API_KEY=
